# Mail credentials (Gmail app password lives here) — keep out of git.
# The wildcard matters: set_mail_password.ps1 and the settings screen leave
# dated copies like system_settings.json.backup_20260812_122341 beside the
# original, and those carry the same app password. Only the exact filename was
# listed, so the backups showed up as untracked and a single `git add -A` would
# have published the password to a public repository.
data/system_settings.json
data/system_settings.json.*

# Automated database backups (large, contain user data)
/backups/

# Uploads - Don't upload user files
/uploads/*
!/uploads/.gitkeep

# Database
*.sql.bak
*.sqlite
*.db

# Logs
*.log
logs/

# OS
Thumbs.db
.DS_Store

# Temporary files
temp/
tmp/
cache/

# Local backups / exported copies
system_backup_*.tar.gz
system_folder_for_desktop.zip
/-WEB-BASED-DEFECTIVE-EQUIPMENT-REPORTING-MANAGEMENT-SYSTEM-FOR-BATANGAS-EASTERN-COLLEGES/

# Runtime rate-limiter state
data/rate_limits/

# Mail retry outbox (undelivered notifications awaiting resend)
data/mail_outbox/

# Timestamp of the last SLA escalation sweep (runtime throttle state)
data/sla_last_sweep

# Same, for the preventive-maintenance sweep. Machine-local runtime state:
# committing it would carry one machine's clock to another and skip a sweep.
data/pm_last_sweep

# PID of the demo keep-awake helper (runtime only)
data/keep_awake.pid

# Heavy PNG master of the landing background (the optimized .jpg derived from it is committed)
assets/Landing Page Background.png
data/vapid.json

# Auto-downloaded tunnel binary for the phone-install demo helper
scripts/tools/
assets/_originals/
uploads/_originals/
scripts/__pycache__/
data/apache_watchdog.pid

# The HMAC key for reporter "remember this device" cookies. Anyone holding it
# can forge a trusted-device cookie for any address and sign in without ever
# receiving a code, so it must never be committed. It regenerates on first use,
# at the cost of every remembered device verifying once more.
data/.reporter_signing_key

# Encrypted credential bundle produced by scripts/carry_secrets.ps1 - never commit
bec-secrets.enc
*.replaced_*
*.away

# Temporary session seeders and diagnostic pages.
# These grant a logged-in session with no authentication, so they must never
# be committed and must not survive on a server. See CLAUDE.md.
_smoke_seed_*.php
_q_tmp*.php
*_diag_*.php
admin_diag_*.php
student_diag_*.php
