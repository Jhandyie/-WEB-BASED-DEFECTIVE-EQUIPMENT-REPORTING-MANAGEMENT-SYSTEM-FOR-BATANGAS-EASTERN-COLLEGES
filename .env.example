### XAMPP local environment example (.env.example)
# Copy this to `.env` and edit as needed when running under XAMPP

DB_DRIVER=mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USERNAME=root
MYSQL_PASSWORD=
MYSQL_DATABASE=bec_system
MYSQL_CHARSET=utf8mb4

# Application settings
APP_ENV=development
APP_DEBUG=true
APP_DB_TIMEZONE=+08:00
DB_DRIVER=mysql

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=bec_equipment_db
MYSQL_USERNAME=root
MYSQL_PASSWORD=
MYSQL_CHARSET=utf8mb4
APP_DB_TIMEZONE=+08:00

PGHOST=
PGPORT=5432
PGDATABASE=
PGUSER=
PGPASSWORD=
PGSSLMODE=require

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=
