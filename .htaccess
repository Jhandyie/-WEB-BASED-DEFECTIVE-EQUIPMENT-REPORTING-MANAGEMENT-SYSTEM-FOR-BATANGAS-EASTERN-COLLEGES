# ──────────────────────────────────────────────────────────────
# BEC Equipment Reporting System — web hardening
# Prevents sensitive server-side files from being served over HTTP.
# (PHP `require`/`include` still work — those read from the filesystem,
#  not via HTTP, so blocking HTTP access here does not break the app.)
# ──────────────────────────────────────────────────────────────

# No directory listings
Options -Indexes

# PWA: correct MIME type for the web-app manifest
AddType application/manifest+json .webmanifest

# Security response headers.
#
# Content-Security-Policy: the pages carry 54 inline <script> blocks and over a
# thousand inline style attributes, so 'unsafe-inline' has to stay until those
# are moved out or given nonces. Be clear about what that means: this policy
# does NOT stop an injected inline script. What it does stop is everything an
# attacker normally does next, and a few whole classes of attack outright:
#
#   default-src 'self'   no resource may be loaded from another origin
#   script-src           no remote script files (only inline, already trusted)
#   connect-src 'self'   fetch/XHR/WebSocket cannot post data off-site
#   form-action 'self'   a form cannot be repointed at someone else's server
#   frame-ancestors      the admin cannot be framed for clickjacking
#   base-uri 'self'      a <base> tag cannot silently re-root every relative URL
#   object-src 'none'    no Flash/Java/plugin embedding
#
# Everything the app needs is served from this host (fonts, icons, Chart.js,
# SheetJS), so 'self' is enough. data: covers the inline SVG backgrounds and
# blob: the camera previews the reporter and technician forms create.
<IfModule mod_headers.c>
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; media-src 'self' blob:; worker-src 'self' blob:; frame-ancestors 'self'; form-action 'self'; base-uri 'self'; object-src 'none'"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Permitted-Cross-Domain-Policies "none"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(self)"
    # HSTS is honored only over HTTPS; harmless (ignored) over plain HTTP in dev.
    Header always set Strict-Transport-Security "max-age=15552000" "expr=%{HTTPS} == 'on'"
</IfModule>

# Asset caching.
# Apache sent no Cache-Control for css/js, so browsers fell back to heuristic
# caching and kept serving an old copy after a file changed — a rewritten
# sign-in loader appeared not to have changed at all. Revalidate on each use:
# the file is still served from cache when unchanged (304), but a new version
# is picked up immediately.
<IfModule mod_headers.c>
    <FilesMatch "(?i)\.(js|css)$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
</IfModule>

# Block dotfiles (.env, .gitignore, etc.)
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Block dot-DIRECTORIES, which the rule above does not reach: FilesMatch tests
# the basename, so .git/config and .git/objects/… were being served. With the
# index, the refs and the object files readable, anyone could reconstruct the
# whole repository — every line of source and its history — from the public
# tunnel. .env was never committed, so no credentials were in reach, but the
# source of a system being hardened should not be either.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule (^|/)\.(git|svn|hg|bzr|idea|vscode)(/|$) - [F,L]
</IfModule>
# Belt and braces if mod_rewrite is off: deny the file types git stores.
<FilesMatch "^(HEAD|ORIG_HEAD|FETCH_HEAD|COMMIT_EDITMSG|index|packed-refs|config|description)$">
    Require all denied
</FilesMatch>

# Block sensitive file types anywhere in the tree
<FilesMatch "(?i)\.(env|log|sql|md|lock|ini|bak|sh|yml|yaml)$">
    Require all denied
</FilesMatch>

# Block the *.example.php and secrets
<FilesMatch "(?i)(chat_secrets\.php|.*\.example\.php)$">
    Require all denied
</FilesMatch>

# Block direct web access to server-only directories
# (data store, logs, config, server includes, MVC layers)
RedirectMatch 403 (?i)/(data|logs|config|includes|models|controllers|backups|scripts)/

# Defense-in-depth: also deny via rewrite if mod_rewrite is on
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule (?i)(^|/)\.env$ - [F,L]
    RewriteRule (?i)/(data|logs|config|includes|models|controllers|backups|scripts)/ - [F,L]
</IfModule>
